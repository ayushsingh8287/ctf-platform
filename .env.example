# Copy to .env (never commit .env). On Render/Railway set these in the dashboard instead.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=paste-64-random-chars-here
ADMIN_EMAIL=organizer@example.com
# generate with: npm run hash -- 'YourStrongAdminPassword'
ADMIN_PASSWORD_HASH=$2a$12$replace_with_generated_hash
NODE_ENV=development
